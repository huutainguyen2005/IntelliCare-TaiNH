# PostgreSQL (Supabase - Session Pooler)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

JWT_SECRET=

# https://resend.com -> API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=

DEVICE_API_KEY=

# Can Xiaomi Mi Scale (BLE) - lay bind key luc ghep noi qua app Xiaomi Home
XIAOMI_SCALE_MAC=
XIAOMI_SCALE_BIND_KEY=
PENDING_TIMEOUT_SECONDS=

# CHI dung 1 lan luc khoi dong dau tien (tao Admin) - xoa sau khi da tao xong
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# local dev - doi thanh domain Frontend that truoc khi len production
CORS_ALLOWED_ORIGINS=*

# Rate limit theo IP
rate-limit.login.max-requests=
rate-limit.register.max-requests=
rate-limit.window-seconds=
rate-limit.trust-cdn-ip-headers=

MOCK_BYPASS_ENABLED=
SWAGGER_ENABLED=